# Back4App (Parse Server) — copy this file to .env and fill in real values
VITE_PARSE_APP_ID=your-back4app-application-id
VITE_PARSE_JS_KEY=your-back4app-javascript-key
VITE_PARSE_SERVER_URL=https://parseapi.back4app.com/

# Cloud Run 中介層（server/，ROADMAP Phase 1）
VITE_MIDDLEWARE_URL=https://tcross-middleware-502746951565.asia-east1.run.app

# Google Maps/Places（選填，用於活動表單「地點」欄位的地址自動建議）
# 需在 Google Cloud Console 啟用 Places API + Maps JavaScript API，並限制此金鑰的
# Website restrictions 只允許 http://localhost:5173/* 與正式網域（見 ROADMAP.md）。
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key



