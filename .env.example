# Parse Server（2026-10-20 起為 GCP 自架的 tcross-parse）— copy this file to .env and fill in real values
VITE_PARSE_APP_ID=your-parse-application-id
VITE_PARSE_JS_KEY=your-parse-javascript-key
VITE_PARSE_SERVER_URL=https://tcross-parse-502746951565.asia-east1.run.app/parse
# 只有維運腳本（scripts/、parse-server/scripts/）用，前端不會讀；值在 Secret Manager parse-server-master-key
PARSE_MASTER_KEY=

# Cloud Run 中介層（server/，ROADMAP Phase 1）
VITE_MIDDLEWARE_URL=https://tcross-middleware-502746951565.asia-east1.run.app

# Google Maps/Places（選填，用於活動表單「地點」欄位的地址自動建議）
# 需在 Google Cloud Console 啟用 Places API + Maps JavaScript API，並限制此金鑰的
# Website restrictions 只允許 http://localhost:5173/* 與正式網域（見 OPERATIONS.md）。
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key



