# Parse Server (self-hosted tcross-parse since 2026-10-20) — verifying session tokens
PARSE_SERVER_URL=https://tcross-parse-502746951565.asia-east1.run.app/parse
PARSE_APP_ID=your-parse-app-id
PARSE_JS_KEY=your-parse-js-key

# Master Key — never put this in the frontend .env, only here. Required by /generate
# (writes GenerationJob status back). In Cloud Run it comes from Secret Manager
# parse-server-master-key.
PARSE_MASTER_KEY=your-parse-master-key

# GCS
GCS_BUCKET=your-gcs-bucket-name
# The Cloud Run service's own runtime service account email — used to
# self-impersonate for signing URLs via the IAM signBlob API.
GCS_SIGNING_SERVICE_ACCOUNT=cloud-run-runtime@your-project.iam.gserviceaccount.com
SIGNED_URL_TTL_MINUTES=15

# CORS — comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGIN=http://localhost:5173

# 只有容器（Dockerfile CMD）用，Python 程式不讀
PORT=8080

# Vertex AI Gemini（Phase 3b：/generate 端點）
# GCP_PROJECT 通常跟 GCS_BUCKET 是同一個專案；GCP_LOCATION 不必跟 Cloud Run 部署的
# region 一樣——這只是呼叫 Vertex AI API 用的 region，選一個目前有開放 Gemini 模型
# 的 region 即可（部署前到 GCP 主控台確認你要用的 GEMINI_MODEL 在該 region 是否可用）。
GCP_PROJECT=your-project-id
GCP_LOCATION=asia-northeast1
GEMINI_MODEL=gemini-2.5-flash
# 照片／影片送進 Gemini 的解析度（LOW／MEDIUM／HIGH），越低越省 token
GEMINI_MEDIA_RESOLUTION=LOW
# 每筆 GenerationJob 最多幾個素材檔（前端 AiGenerationModal.vue 的 MAX_SOURCE_FILES 要一致）
MAX_SOURCE_FILES=20
# AI 報告 PDF 的中文字型資料夾（預設 /usr/share/fonts/noto-tc，Docker 建置時由 fetch_fonts.py 下載）。
# 本機要產 PDF 時指到任一資料夾，再跑 python fetch_fonts.py
# REPORT_FONT_DIR=
