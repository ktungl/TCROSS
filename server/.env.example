# Parse / Back4App — verifying session tokens (JS Key only, no secrets here)
PARSE_SERVER_URL=https://parseapi.back4app.com
PARSE_APP_ID=your-back4app-app-id
PARSE_JS_KEY=your-back4app-js-key

# Master Key — never put this in the frontend .env, only here. Required once
# Phase 2/3 write-back endpoints are added; leave unset until then if you prefer.
PARSE_MASTER_KEY=your-back4app-master-key

# GCS
GCS_BUCKET=your-gcs-bucket-name
# The Cloud Run service's own runtime service account email — used to
# self-impersonate for signing URLs via the IAM signBlob API.
GCS_SIGNING_SERVICE_ACCOUNT=cloud-run-runtime@your-project.iam.gserviceaccount.com
SIGNED_URL_TTL_MINUTES=15

# CORS — comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGIN=http://localhost:5173

PORT=8080
